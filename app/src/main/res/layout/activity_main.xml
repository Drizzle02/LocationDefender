<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1A1A2E">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛡️ Location Defender"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Multi-Layer Location Security Analysis"
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        android:gravity="center"
        android:paddingBottom="24dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Initializing..."
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="16dp"
        android:background="#16213E"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_detection"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🔍 Multi-Layer Detection (6 Layers)"
        android:textSize="16sp"
        android:background="#E94560"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_behavioral"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="📊 Behavioral Analysis"
        android:textSize="16sp"
        android:background="#0F3460"
        android:textColor="#FFFFFF" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Based on reverse engineering analysis of HideMockLocation module"
        android:textSize="12sp"
        android:textColor="#666666"
        android:gravity="center"
        android:paddingTop="16dp" />

</LinearLayout>
