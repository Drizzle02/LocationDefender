<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Behavioral Analysis"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚫ Ready to Monitor"
            android:textSize="16sp"
            android:textColor="#FF9800"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Start"
                android:background="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Stop"
                android:background="#F44336"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp" />

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="↺"
                android:background="#2196F3"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Behavioral Score"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tv_behavioral_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Behavioral Score: --/100"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verdict"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tv_behavioral_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verdict: --"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analysis Results"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tv_behavioral_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Results: --"
            android:textSize="14sp"
            android:textColor="#FFC107"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Location Data"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tv_latest_lat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lat: --"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tv_latest_lng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lng: --"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tv_latest_acc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accuracy: --"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tv_latest_provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Provider: --"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tv_location_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Samples: 0"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:paddingBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Behavioral Patterns Analyzed:"
            android:textSize="14sp"
            android:textColor="#666666"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Speed/Velocity Consistency\n• Coordinate Jitter Analysis\n• Update Interval Regularity\n• Accuracy Stability\n• Timestamp Integrity\n• Position Stability Patterns"
            android:textSize="12sp"
            android:textColor="#888888"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</ScrollView>
